  {
    "name": "valid_2d",
    "document": {
      "schema": "sci-ir/1",
      "id": "sample_2d",
      "title": "Sample 2D",
      "sceneType": "scene_2d",
      "objects": [
        {
          "id": "panel",
          "type": "ui.panel",
          "properties": {
            "width": 6.0,
            "height": 3.0,
            "title": "Panel"
          },
          "transform": {
            "position": [
              -2.5,
              1.0,
              0.0
            ],
            "rotation": 0.0,
            "scale": 1.0
          }
        },
        {
          "id": "eq",
          "type": "math.formula",
          "properties": {
            "source": "tau = J(theta).T @ F",
            "fontSize": 40
          },
          "transform": {
            "position": [
              2.0,
              -0.5,
              0.0
            ],
            "rotation": 0.0,
            "scale": 1.0
          }
        }
      ],
      "expressions": [
        {
          "id": "eq",
          "source": "tau = J(theta).T @ F",
          "terms": {
            "Jt": "J(theta).T"
          },
          "bindings": {
            "theta": {
              "kind": "literal",
              "value": 0.6
            }
          },
          "highlights": [
            "J(theta).T"
          ]
        }
      ],
      "values": [
        {
          "id": "energy",
          "source": {
            "kind": "derived",
            "expr": "a * b + 1",
            "inputs": {
              "a": {
                "kind": "literal",
                "value": 2
              },
              "b": {
                "kind": "literal",
                "value": 3
              }
            }
          },
          "format": "E = {value:.2f}"
        }
      ],
      "relationships": [
        {
          "id": "link",
          "kind": "arrow",
          "sources": [
            "panel",
            "eq"
          ],
          "live": true
        }
      ],
      "bindings": {
        "theta": {
          "kind": "literal",
          "value": 0.6
        }
      },
      "timeline": [
        {
          "id": "s1",
          "title": "Intro",
          "steps": [
            {
              "op": "show",
              "target": "panel"
            },
            {
              "op": "play",
              "target": "eq",
              "animation": "write",
              "duration": 1.5
            },
            {
              "op": "highlight",
              "target": "eq",
              "duration": 1.0,
              "properties": {
                "color": "warn"
              }
            },
            {
              "op": "custom",
              "code": "print('boundary')"
            }
          ]
        }
      ]
    },
    "expectValid": true
  },
